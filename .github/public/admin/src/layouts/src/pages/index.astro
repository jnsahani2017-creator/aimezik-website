---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
  <section class="pt-32 pb-16 bg-gradient-to-br from-primary-50 to-white dark:from-gray-900 dark:to-gray-800">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-6xl font-extrabold text-gray-900 dark:text-white">
        Learn AI Video Creation with
        <span class="text-primary-600 dark:text-primary-400">AIMEZIK</span>
      </h1>
      <p class="mt-6 text-xl text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
        Create Cartoon Videos, Bhakti Videos, News Videos, AI Shorts, Reels and More.
      </p>
      <div class="mt-8 flex flex-wrap gap-4 justify-center">
        <a href="/prompts" class="px-8 py-3 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700 transition-colors">
          Explore Prompts
        </a>
        <a href="/videos" class="px-8 py-3 bg-white dark:bg-gray-800 text-gray-900 dark:text-white font-semibold rounded-lg shadow-md hover:shadow-lg transition-shadow">
          Watch Videos
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
