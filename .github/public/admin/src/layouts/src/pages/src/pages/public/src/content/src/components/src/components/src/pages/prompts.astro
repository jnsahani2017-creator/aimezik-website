---
import BaseLayout from '@layouts/BaseLayout.astro';
import PromptCard from '@components/PromptCard.astro';
import { getCollection } from 'astro:content';

const prompts = await getCollection('prompts');
const sortedPrompts = prompts.sort((a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime());
---

<BaseLayout title="AI Prompts" description="Browse our collection of AI video creation prompts.">
  <div class="max-w-7xl mx-auto px-4 py-8 md:py-12">
    <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-white">AI Prompts</h1>
    <p class="mt-2 text-gray-600 dark:text-gray-400">Browse and copy ready-made prompts for AI video creation</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
      {sortedPrompts.map(prompt => (
        <PromptCard 
          title={prompt.data.title}
          slug={prompt.slug}
          thumbnail={prompt.data.thumbnail}
          category={prompt.data.category}
          featured={prompt.data.featured}
        />
      ))}
    </div>

    {sortedPrompts.length === 0 && (
      <div class="text-center py-12">
        <p class="text-gray-500 dark:text-gray-400">No prompts added yet. Check back later!</p>
      </div>
    )}
  </div>
</BaseLayout>
