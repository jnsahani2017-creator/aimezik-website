---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime());
---

<BaseLayout title="Blog" description="Read the latest articles on AI news, CSC updates, and technology.">
  <div class="max-w-7xl mx-auto px-4 py-8 md:py-12">
    <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 dark:text-white">Blog</h1>
    <p class="mt-2 text-gray-600 dark:text-gray-400">Read the latest articles on AI news, CSC updates, and technology</p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
      {sortedPosts.map(post => (
        <a href={`/blog/${post.slug}`} class="group bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-all hover:-translate-y-1">
          <img src={post.data.thumbnail} alt={post.data.title} class="w-full aspect-video object-cover" loading="lazy" />
          <div class="p-4">
            <span class="text-xs text-primary-600 dark:text-primary-400 font-semibold uppercase">{post.data.category}</span>
            <h3 class="mt-1 text-lg font-bold text-gray-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors line-clamp-2">
              {post.data.title}
            </h3>
          </div>
        </a>
      ))}
    </div>

    {sortedPosts.length === 0 && (
      <div class="text-center py-12">
        <p class="text-gray-500 dark:text-gray-400">No posts added yet. Check back later!</p>
      </div>
    )}
  </div>
</BaseLayout>
