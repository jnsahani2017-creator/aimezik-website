---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <div class="flex flex-col items-center justify-center min-h-[70vh] text-center px-4">
    <h1 class="text-8xl md:text-9xl font-extrabold text-gray-200 dark:text-gray-700">404</h1>
    <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Page Not Found</h2>
    <a href="/" class="mt-6 px-8 py-3 bg-primary-600 text-white font-semibold rounded-lg hover:bg-primary-700 transition-colors">
      Back to Home
    </a>
  </div>
</BaseLayout>
